# ─────────────────────────────────────────────────────────────────────
# GripFit Web — environment template
#
# Copy to .env.local for development; set the same keys in the Vercel
# project settings for preview and production.
#
# EVERY variable here is optional: the site builds, deploys, and renders
# with none of them set — forms accept input and log instead of sending.
# The ones marked "before launch" must be filled in before going live.
#
# Prices, discounts, copy, and links are NOT env vars — edit lib/admin.ts.
# Schema and validation live in lib/env.ts. Setup steps: docs/ADMIN.md §4.
# ─────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────
# Absolute public origin, e.g. https://gripfit.com
# BEFORE LAUNCH — sitemap.xml, robots.txt, and OG tags need it to build
# absolute URLs. Without it the sitemap renders empty.
NEXT_PUBLIC_SITE_URL=

# ── Brevo — all outbound email + email capture ────────────────────────
# Brevo v3 API key. SERVER ONLY — never add a NEXT_PUBLIC_ prefix.
# Brevo dashboard: SMTP & API → API keys.
# BEFORE LAUNCH.
BREVO_API_KEY=

# Numeric id of the Brevo list that website discount signups join.
# Brevo dashboard: Contacts → Lists (the id appears in the list URL).
# BEFORE LAUNCH.
BREVO_WEBSITE_LIST_ID=

# A sender address VERIFIED in Brevo — unverified senders are rejected.
# Brevo dashboard: Senders, Domains & Dedicated IPs. Prefer full domain
# authentication (SPF/DKIM) over a single verified address.
# BEFORE LAUNCH.
BREVO_SENDER_EMAIL=

# Display name on outbound mail. Defaults to "GripFit" when unset.
BREVO_SENDER_NAME=

# Optional. Brevo template id for the discount-code email; leave blank to
# use the built-in inline HTML. A template receives {{ params.DISCOUNT_CODE }}.
BREVO_DISCOUNT_TEMPLATE_ID=

# Inbox the contact form delivers to. Can differ from the support address
# shown on the site (lib/admin.ts → links.supportEmail).
# BEFORE LAUNCH.
CONTACT_EMAIL_TO=

# ── Shopify — parked for v2, leave blank ──────────────────────────────
# Decisions.md §7 / §16 Q3. No component imports lib/shopify/ in v1.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-04
