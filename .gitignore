# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values
.env*
# ...except the template, which holds only key names and setup notes.
# Without this, `cp .env.example .env.local` fails on a fresh clone.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
